@baseurl = http://localhost:5235
@buyerId = jan

### Get basket (empty if it does not exist yet)
GET {{baseurl}}/api/basket/{{buyerId}}
Accept: application/json

### Replace basket
PUT {{baseurl}}/api/basket/{{buyerId}}
Content-Type: application/json

{
  "items": [
    {
      "productId": 1,
      "quantity": 2
    },
    {
      "productId": 2,
      "quantity": 1
    }
  ]
}

### Get basket after update (should return both items)
GET {{baseurl}}/api/basket/{{buyerId}}
Accept: application/json

### Get basket of another buyer (should be empty)
GET {{baseurl}}/api/basket/ola
Accept: application/json

### Invalid item (should return 400)
PUT {{baseurl}}/api/basket/{{buyerId}}
Content-Type: application/json

{
  "items": [
    {
      "productId": 0,
      "quantity": 1000
    }
  ]
}

### productId = 999 (should return 400)
PUT {{baseurl}}/api/basket/999
Content-Type: application/json

{
  "items": [
    {
      "productId": 999,
      "quantity": 1
    }
  ]
}


### Delete basket (204 first time, 404 second time)
DELETE {{baseurl}}/api/basket/{{buyerId}}


###
GET https://localhost:7227/api/basket/user1